{
  "rewrites": [
    {
      "source": "/predict(.*)",
      "destination": "YOUR_DEPLOYED_BACKEND_URL/predict$1"
    },
    {
      "source": "/weather/get-weather(.*)",
      "destination": "YOUR_DEPLOYED_BACKEND_URL/weather/get-weather$1"
    },
    {
      "source": "/disease/api(.*)",
      "destination": "YOUR_DEPLOYED_BACKEND_URL/disease/api$1"
    },
    {
      "source": "/chatbot/send-message(.*)",
      "destination": "YOUR_DEPLOYED_BACKEND_URL/chatbot/send-message$1"
    },
    {
      "source": "/alerts/get-alerts(.*)",
      "destination": "YOUR_DEPLOYED_BACKEND_URL/alerts/get-alerts$1"
    },
    {
      "source": "/send-contact(.*)",
      "destination": "YOUR_DEPLOYED_BACKEND_URL/send-contact$1"
    },
    {
      "source": "/media(.*)",
      "destination": "YOUR_DEPLOYED_BACKEND_URL/media$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
